# Database (Neon / PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/database_name"

# JWT SECRET
JWT_ACCESS_SECRET=="your_super_secret_jwt_key_change_this_in_production"

# EXPIRES
JWT_ACCESS_EXPIRES=1d

# REFRESH SECRET
JWT_REFRESH_SECRET=your_refresh_secret

# EXPIRES
JWT_REFRESH_EXPIRES=7d

# PRODUCTION | DEVELOPMENT - COOKIES
NODE_ENV=production

# Bcrypt
BCRYPT_SALT=10

# Upstash Redis
UPSTASH_REDIS_REST_URL="https://example-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="example_token_123456789abcdef"